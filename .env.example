# BELL PR settings. Most setups need none of them: every line below is
# commented out and shows the default or an example.
#
# Use them in one of these ways:
#   - export the variables in your shell before you run `bell-pr`;
#   - copy this file, uncomment what you need and start with
#     `bell-pr start --env-file <file>` (variables already set in the
#     environment win);
#   - for the systemd unit in contrib/systemd, put them in
#     ~/.config/bell-pr/environment;
#   - for Docker, pass them with `docker run -e NAME=value` or --env-file.
#
# BELL PR reads them when it starts, so restart it after a change. Where the
# app's Settings page has the same setting, the variable wins and the app
# shows it as set by the environment. docs/configuration.md describes them.
#
# Keep a file that holds a license key private (chmod 600).

# --- Where BELL PR runs -------------------------------------------------------

# Port for the web interface and the API (1024-65535). Also --port.
# BELLPR_PORT=4311

# Address to listen on. Also --host. The default, 127.0.0.1, accepts
# connections from this computer only. 0.0.0.0 or :: listen on every address
# but still answer only requests addressed to this computer (the Docker image
# uses 0.0.0.0 inside the container). Any other address must sit behind an
# HTTPS reverse proxy (see docs/self-hosting.md) with BELLPR_PUBLIC_URL set,
# or BELL PR refuses to start.
# BELLPR_HOST=127.0.0.1

# The address browsers use when BELL PR is behind a reverse proxy or a
# different published port, without a path. BELL PR prints sign-in links for
# it and accepts requests for it. Use https for anything other than this
# computer.
# BELLPR_PUBLIC_URL=https://bell.example.com

# Extra exact HTTP(S) origins to accept, separated by commas; plain http
# only for loopback addresses. Rarely needed: BELLPR_PUBLIC_URL already adds
# its own origin.
# BELLPR_ALLOWED_ORIGINS=https://bell.example.com

# Where repositories, isolated worktrees and run records are stored. Also
# --data-dir. The default is ~/.bellpr (the .bellpr folder in your home
# directory); an absolute path is safest. BELL PR never moves data by itself.
# BELLPR_DATA_DIR=~/.bellpr

# Set to 1 (any value but 0 or false) to never open a browser at start or
# for `bell-pr open`. BELL PR also skips the browser in CI, in containers and
# when output is not a terminal. Also --no-open.
# BELLPR_NO_OPEN=1

# --- Language and logs ---------------------------------------------------------

# Language of server and command-line messages when no other choice applies:
# en (default) or zh-TW. The app's language setting takes precedence.
# BELLPR_LOCALE=en

# How much the server logs: debug, info (default), warn or error.
# BELLPR_LOG_LEVEL=info

# --- License -------------------------------------------------------------------

# A Pro license key. It overrides the key saved with `bell-pr license
# activate`. Never commit it.
# BELLPR_LICENSE_KEY=<your license key>

# --- Agents --------------------------------------------------------------------

# Maximum number of agent CLI processes running at once across all runs,
# project analyses and discovery (1 to 32). Lower it when your AI plan has
# tight usage limits. Settings > Performance in the app sets the same.
# BELLPR_MAX_AGENT_PROCESSES=3

# Maximum number of contribution runs executing at once (1 to 8; the Free
# plan runs one). Running, queued and plan-approval runs together are capped
# at 8 or twice this value, whichever is larger. Each run's agents still count
# against BELLPR_MAX_AGENT_PROCESSES. Settings > Performance sets the same.
# BELLPR_MAX_ACTIVE_RUNS=2

# Multiplier for the timeout of a single agent turn (0.5 to 10). Base
# timeouts: 240 s for project analysis and discovery, 600 s for read-only
# turns and 1800 s for turns that write code. Claude Code turns get 2.5 times
# as long, effort xhigh 1.5 times and max 2 times, up to 2 hours in total.
# Raise it if large projects or higher efforts still time out. Settings >
# Performance sets the same.
# BELLPR_AGENT_TIMEOUT_SCALE=1

# Set to 1 to let Claude Code agents that write code run without the
# operating-system sandbox when it is unavailable (bubblewrap and socat on
# Linux). Those agents can then read and change anything your user account
# can. Runs started this way are marked as unsandboxed. Leave it unset unless
# you understand the risk. Settings > Agent safety sets the same.
# BELLPR_ALLOW_UNSANDBOXED_AGENTS=1

# --- Storage -------------------------------------------------------------------

# Days after its last activity that a cancelled or failed run keeps its
# working files (1 to 365); then they are removed. Run records, reports and
# notes stay. Runs in review, approved and published runs keep their
# worktree, since syncing a published PR or starting a follow-up round needs
# it; free one by hand in Settings > Data & privacy when you no longer need
# it, where the retention period can be set as well.
# BELLPR_RETENTION_DAYS=14

# --- Contributors only ---------------------------------------------------------
# Needed only when you work on BELL PR itself with `npm run dev`.

# Development mode: sign-in is off and the API trusts the Vite dev server.
# `npm run dev` sets it; it only works on 127.0.0.1.
# BELLPR_DEV=1

# Port of the Vite dev server that the API accepts in development mode. Keep
# the dev:web script in package.json and the proxy in vite.config.ts in sync
# when you change it or BELLPR_PORT.
# BELLPR_FRONTEND_PORT=4310

# The built web interface. Defaults to the dist/ folder that comes with
# BELL PR.
# BELLPR_STATIC_DIR=/path/to/dist
