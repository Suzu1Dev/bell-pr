# BELL PR does not load .env files by itself. Export these variables in your
# shell, or load this file as the README describes. Most setups need none of
# them.

# Local port for the API and the built web app. In development, keep the
# proxy in vite.config.ts in sync when you change it.
BELLPR_PORT=4311

# Extra exact HTTP(S) origins to accept, separated by commas. By default only
# local addresses are accepted.
# Use this only behind a private reverse proxy that already controls access:
# it does not add user authentication. The API still listens on 127.0.0.1
# only, and the proxy must keep the original Host header.
# BELLPR_ALLOWED_ORIGINS=https://bell.example.internal

# Maximum number of agent CLI processes running at once (1 to 32). Lower it
# when your AI plan has tight usage limits.
BELLPR_MAX_AGENT_PROCESSES=3

# Maximum number of contribution runs executing at once (1 to 8). Running,
# queued and plan-approval runs together are capped at 8 or twice this value,
# whichever is larger. Each run's agents still count against
# BELLPR_MAX_AGENT_PROCESSES.
BELLPR_MAX_ACTIVE_RUNS=2

# Multiplier for the timeout of a single agent turn (0.5 to 10). Base
# timeouts: 240 s for project analysis and discovery, 600 s for read-only
# turns and 1800 s for turns that write code. Claude Code turns get 2.5 times
# as long, effort xhigh 1.5 times and max 2 times, up to 2 hours in total.
# Raise it if large projects or higher efforts still time out.
BELLPR_AGENT_TIMEOUT_SCALE=1

# Where repositories, isolated worktrees and run records are stored.
# Defaults to .bellpr in the directory you start BELL PR from; an absolute
# path also works.
BELLPR_DATA_DIR=.bellpr

# --- Contributors only -------------------------------------------------------
# Needed only when you work on BELL PR itself with `npm run dev`.

# Port of the Vite dev server that the API accepts requests from. Keep the
# dev:web script in package.json in sync when you change it.
BELLPR_FRONTEND_PORT=4310
