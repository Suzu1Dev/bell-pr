# Fixture Git config for the credential-store deny list.
# Plain `store` keeps the default ~/.git-credentials file.
# `cache` and a shell helper are not store files.
[credential]
	helper = store
	helper = store --file ~/.bell-pr-custom-credentials
	helper = store --file=/tmp/bell-pr-store-credentials
	helper = cache --timeout 300
	helper = "!f() { :; }; f"
