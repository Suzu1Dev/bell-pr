[Unit]
Description=BELL PR contribution workbench
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/bell-pr
Environment=NODE_ENV=production
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/bell-pr/environment
ExecStart=/usr/bin/node %h/apps/bell-pr/node_modules/tsx/dist/cli.mjs %h/apps/bell-pr/server/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
