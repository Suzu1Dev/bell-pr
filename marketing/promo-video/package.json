{
  "name": "bell-pr-promo-video",
  "version": "1.0.0",
  "private": true,
  "description": "The BELL PR v1.1 launch film (86.8 s), built with Remotion from real UI footage of the sample project.",
  "type": "module",
  "scripts": {
    "capture": "node scripts/capture.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "hit": "node scripts/measure-hit.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "npm run render:web && npm run render:master",
    "render:web": "npm run render:mp4 && npm run render:webm && npm run render:poster && npm run captions",
    "render:mp4": "remotion render src/index.ts Promo out/bell-pr-promo-en-1080p.mp4 --codec=h264 --crf=24 --x264-preset=slow --audio-codec=aac --audio-bitrate=192k --concurrency=4",
    "render:webm": "remotion render src/index.ts Promo out/bell-pr-promo-en-1080p.webm --codec=vp9 --crf=35 --audio-codec=opus --audio-bitrate=160k --concurrency=4",
    "render:master": "remotion render src/index.ts Promo out/bell-pr-promo-en-2160p.mp4 --scale=2 --codec=h264 --crf=16 --x264-preset=slow --audio-codec=aac --audio-bitrate=320k --concurrency=3",
    "render:poster": "remotion still src/index.ts Promo out/poster.jpg --frame=2590 --image-format=jpeg --jpeg-quality=85",
    "captions": "node scripts/export-captions.mjs",
    "build": "npm run capture && npm run assets && npm run hit && npm run render && npm run check",
    "check": "node scripts/check-output.mjs",
    "stills": "node scripts/stills.mjs",
    "review": "node scripts/review-frames.mjs",
    "site": "node scripts/copy-to-site.mjs",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@remotion/bundler": "4.0.531",
    "@remotion/cli": "4.0.531",
    "@remotion/renderer": "4.0.531",
    "playwright-core": "~1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.531",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
