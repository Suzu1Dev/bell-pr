{
  "name": "bell-pr",
  "version": "1.0.0-rc.1",
  "description": "From vibe coding to knowing why. A local workbench for AI-assisted open-source contributions: an agent team builds the change in isolated git worktrees, you learn every change, explain it back and send one Draft PR that follows the project's rules.",
  "keywords": [
    "open-source",
    "contributions",
    "pull-request",
    "code-review",
    "ai-agents",
    "git-worktree",
    "self-hosted",
    "local-first",
    "learning"
  ],
  "bugs": {
    "url": "https://github.com/Suzu1Dev/bell-pr/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Suzu1Dev/bell-pr"
  },
  "author": "Suzu1Dev",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "bell-pr": "bin/bellpr.mjs",
    "bellpr": "bin/bellpr.mjs"
  },
  "files": [
    "bin/",
    "build/",
    "dist/",
    "!dist/.vite/",
    "vendor/ponytail/rules.md",
    "vendor/ponytail/LICENSE",
    "vendor/ponytail/provenance.json",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 4310 --strictPort",
    "dev:server": "BELLPR_DEV=1 tsx watch server/index.ts --dev",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs && node scripts/generate-third-party-notices.mjs",
    "prepack": "npm run build && node scripts/npm-readme.mjs --pre",
    "postpack": "node scripts/npm-readme.mjs --post",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "node bin/bellpr.mjs start --no-open",
    "test": "tsx --import ./test/css-stub.mjs --test \"server/**/*.test.ts\" \"shared/**/*.test.ts\" \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "audit": "node scripts/audit.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:personal": "node scripts/check-personal-info.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:meta": "node scripts/sync-package-meta.mjs --check",
    "check:generated": "tsx scripts/render-generated-regions.ts --check",
    "release:dry-run": "node scripts/release-dry-run.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "bellpr": {
    "releaseDate": "2026-10-20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@eslint/js": "~9.39.5",
    "@fontsource-variable/dm-sans": "~5.3.0",
    "@fontsource/ibm-plex-mono": "~5.3.0",
    "@playwright/test": "~1.64.0",
    "@types/express": "^5.0.0",
    "@types/mdast": "~4.0.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "esbuild": "~0.28.2",
    "eslint": "~10.13.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "globals": "~17.13.0",
    "lucide-react": "^1.59.0",
    "micromark-util-sanitize-uri": "~2.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "~8.70.1",
    "vite": "^8.3.5"
  }
}
